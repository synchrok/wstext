{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WSText",
  "version": "0.2.1",
  "identifier": "com.wstext.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "wstext",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt"
        ],
        "name": "Plain Text",
        "description": "Plain Text Document",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "md"
        ],
        "name": "Markdown",
        "description": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "json"
        ],
        "name": "JSON",
        "description": "JSON Document",
        "role": "Editor",
        "mimeType": "application/json"
      },
      {
        "ext": [
          "xml"
        ],
        "name": "XML",
        "description": "XML Document",
        "role": "Editor",
        "mimeType": "application/xml"
      },
      {
        "ext": [
          "yaml",
          "yml"
        ],
        "name": "YAML",
        "description": "YAML Document",
        "role": "Editor",
        "mimeType": "application/x-yaml"
      },
      {
        "ext": [
          "js"
        ],
        "name": "JavaScript",
        "description": "JavaScript Source",
        "role": "Editor",
        "mimeType": "text/javascript"
      },
      {
        "ext": [
          "html"
        ],
        "name": "HTML",
        "description": "HTML Document",
        "role": "Editor",
        "mimeType": "text/html"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMkVBOUYzQUM3QUQ3NUIKUldSYjEzcXM4Nmt1NjJqRnJkVzVkWXRQY3pCZjhmZjlzdGhNWE9KUnI1MjdxZ0VhbG9CVEI0aXQK",
      "endpoints": [
        "https://github.com/synchrok/wstext/releases/latest/download/latest.json"
      ]
    }
  }
}
